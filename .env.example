# Anthropic API key used only by the optional contextual classifier layer
# (dlp/llm_classifier.py). This is a normal API key with its own billing,
# separate from Claude Enterprise seats - it's just used as a text classifier.
ANTHROPIC_API_KEY=sk-ant-replace_me

# Model used for the contextual classifier layer. Keep this small/fast since
# it runs inline on live proxy traffic.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Company-specific terms to flag (codenames, client names, unreleased products).
# One per line, case-insensitive substring match. See company_dictionary.txt.
COMPANY_DICTIONARY_PATH=./company_dictionary.txt
